    "test": "node --test \"tests/**/*.test.js\"",
    "smoke": "bash scripts/smoke.sh",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
