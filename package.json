{
  "name": "react-taskboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React + Vite task board: browser-only localStorage persistence, deep-link routing, search/filter and accessible CRUD UI.",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
