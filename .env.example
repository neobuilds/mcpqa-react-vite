# React Taskboard runtime configuration.
# Copy to .env (or export in the platform environment) and adjust values.
# None of these values are secrets; this static client app has no backend.

# Build-time release marker baked into the bundle and shown in the footer
# ("build: <value>"). scripts/build.sh writes VERSION from git by default
# and passes it here, so this only matters for manual `npm run dev` calls.
VITE_BUILD=local

# Vite dev server (defaults shown; used by `npm run dev`)
VITE_HOST=0.0.0.0
VITE_PORT=5173

# Vite preview / production static server (defaults shown; used by
# `npm run preview` and `npm run start`)
PREVIEW_HOST=0.0.0.0
PREVIEW_PORT=4173